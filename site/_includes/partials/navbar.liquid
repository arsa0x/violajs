{% assign currentNav = navType | default: "landing" %}
{% assign items = navigation[currentNav] %}

<header class="site-header">
  <nav class="nav container" aria-label="Main navigation">
    <a class="brand" href="{{ navigation.brand.url | url }}" aria-label="{{ navigation.brand.prefix }}{{ navigation.brand.suffix }} home">
      <span class="brand-mark">{{ navigation.brand.mark }}</span>
      <span>{{ navigation.brand.prefix }}<span class="brand-light">{{ navigation.brand.suffix }}</span></span>
    </a>
    <button class="nav-toggle" aria-label="Open navigation" aria-expanded="false">
      <span></span><span></span>
    </button>

    <div class="nav-links" id="nav-links">
      {% for item in items %}
        {% if item.external %}
          <a class="nav-github" href="{{ item.url }}" target="_blank" rel="noreferrer">{{ item.label }} <span aria-hidden="true">↗</span></a>
        {% elsif item.url contains "#" %}
          <a href="{{ item.url }}">{{ item.label }}</a>
        {% else %}
          <a href="{{ item.url | url }}" {% if page.url == item.url %}aria-current="page" class="active"{% endif %}>{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </div>
  </nav>
</header>
