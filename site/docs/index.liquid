---
layout: layouts/base.liquid
navType: docs
title: Documentation — violajs
---

<section class="container docs-index-main">
  <a class="docs-back-link" href="{{ '/' | url }}">← Back to overview</a>
  <div class="docs-index-heading">
    <span class="section-kicker">VIOLAJS / DOCUMENTATION</span>
    <h1>
      Build something <span class="gradient-text">with violajs.</span>
    </h1>
    <p>
      Guides and references to help you build, extend, and manage your
      WhatsApp bot.
    </p>
  </div>
  <div class="docs-index-grid">
    {% for item in collections.sortedDocs %}
      {% capture idx %}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}{% endcapture %}
      {% assign docTitle = item.data.title | default: item.content | extractTitle: item.fileSlug %}
      {% assign docDesc = item.data.description | default: "Read the violajs documentation." %}

      <a class="docs-index-card" href="{{ item.url | url }}">
        <span class="docs-index-number">{{ idx }}</span>
        <span class="docs-index-card-copy">
          <strong>{{ docTitle }}</strong>
          <small>{{ docDesc }}</small>
        </span>
        <span class="docs-index-arrow">↗</span>
      </a>
    {% endfor %}
  </div>
</section>
