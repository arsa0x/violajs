{
  "name": "violajs",
  "module": "index.ts",
  "type": "module",
  "version": "0.4.0",
  "author": {
    "name": "arsa",
    "email": "0xarsa@proton.me",
    "url": "https://github.com/arsa0x"
  },
  "repository": {
    "url": "https://github.com/arsa0x/violajs"
  },
  "license": "MIT",
  "keywords": [
    "bot",
    "whatsapp",
    "bun",
    "multi-device",
    "multi-session"
  ],
  "private": true,
  "scripts": {
    "start": "bun index.ts",
    "dev": "bun run dev.ts",
    "dev:web": "bun run scripts/server.ts",
    "build": "bun run generate && bun scripts/build.js",
    "generate:docs": "bun scripts/generate-docs.ts",
    "generate:pages": "bun scripts/generate-pages.ts && bun fmt",
    "generate:plugins": "bun scripts/generate-config.js && bun scripts/generate.ts && bun fmt",
    "generate:all": "bun run generate:docs && bun run generate:pages && bun run generate:plugins"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "baileys": "^7.0.0-rc14",
    "cheerio": "^1.2.0",
    "link-preview-js": "^5.0.1"
  },
  "packageManager": "bun",
  "engines": {
    "bun": ">=1.4.0"
  }
}
